# ---- Turso database (required) ----
TURSO_DATABASE_URL=libsql://cafe-kanishk.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=paste_your_token_here

# ---- Staff login (required) ----
# Protects /kitchen and /admin. Pick something only your staff know.
STAFF_PASSWORD=change-me
# Used to sign the staff session cookie. Any long random string.
SESSION_SECRET=change-me-too

# ---- SMS for real OTPs (optional) ----
# Leave BOTH blank to run in demo mode: the code is shown on screen instead
# of being texted. Fill ONE of these to send real SMS.
#
# MSG91 (msg91.com) - create an OTP template, then:
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
#
# Fast2SMS (fast2sms.com) - just the API key:
FAST2SMS_API_KEY=

# ---- Optional ----
PORT=3000
GST_PERCENT=0

# ---- Razorpay (optional; leave blank to keep counter-only payment) ----
# Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. Subscribe to payment.captured and
# payment.failed, pointing at https://<your-domain>/api/payments/webhook
# Without this an order paid on a phone that then loses signal is never
# confirmed, so set it before taking real money.
RAZORPAY_WEBHOOK_SECRET=

# Day boundary for "today's takings". IST unless you host somewhere odd.
TZ_OFFSET=+05:30
